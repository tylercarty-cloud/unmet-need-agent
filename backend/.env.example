# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-5

# Google Sheets configuration
GOOGLE_SHEETS_ID=your-google-sheet-id-here
GOOGLE_SHEETS_RANGE=Sheet1!A:H
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service-account.json

# Slack ingestion + publishing (optional). Leave SLACK_BOT_TOKEN blank to
# disable both. The bot must be invited to the channel and have scopes:
#   channels:history, groups:history, users:read, team:read,
#   chat:write   (required to publish unmet needs back to the channel)
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0123456789
SLACK_MESSAGE_LIMIT=1000

# Set SLACK_PUBLISH_ENABLED=false to ingest from Slack without writing back.
SLACK_PUBLISH_ENABLED=true
SLACK_PUBLISH_STATE_PATH=./data/posted_requests.json

# Dashboard URL stamped into the "View in dashboard" button on each post.
DASHBOARD_URL=http://localhost:5173

# Roadmap alignment — a second Claude pass that pairs each unmet need with
# matching items from roadmap.md (does not affect bucketing). Set
# ALIGNMENT_ENABLED=false to skip this pass.
ROADMAP_PATH=./roadmap.md
ALIGNMENT_ENABLED=true

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# Optional cache TTL in seconds (0 disables caching). Default: 0
CACHE_TTL_SECONDS=0
